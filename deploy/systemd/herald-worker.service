[Unit]
Description=Pulse Celery worker (generation, publishing, metrics)
Documentation=https://github.com/r2st/Herald
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=herald
Group=herald
WorkingDirectory=/opt/Herald/backend
EnvironmentFile=/opt/Herald/.env
# --concurrency=2: the box has 4 GB shared with five other apps, and this
# workload is IO-bound on LLM and platform APIs rather than CPU-bound.
ExecStart=/opt/Herald/.venv/bin/celery -A app.tasks.celery_app:celery_app worker --loglevel=info --concurrency=2
Restart=always
RestartSec=10
# KillMode=mixed sends the stop signal to the main celery process only, and
# leaves it to hand a warm shutdown down to its own children. The default sends
# SIGTERM to every process in the cgroup at once, which kills the pool workers
# out from under the parent that was trying to let them finish — a publish
# interrupted between "the platform accepted this" and "the row says so" is the
# expensive kind of interrupted.
KillMode=mixed
# Long enough for a publish already talking to a platform API to finish. A task
# that outlasts this is killed, which is why it is generous: the publish path is
# idempotent on retry but a redeploy should not be exercising that.
#
# The number is not a guess — it has to clear the longest hard ``time_limit``
# any registered task carries, which is 360s on the beat sweeps. At 120 it
# cleared four of the eighteen: a token purge and a cancelled publication at
# 60s, one metrics poll and one webhook delivery at 90s. Not the row purges —
# those sit at exactly 120, and a kill landing on the same second as the limit
# is not clearance. For everything above it the warm shutdown was still waiting
# on work Celery itself was still willing to run when systemd killed the pool,
# which is to say the drain was decorative on exactly the tasks worth draining
# — and ``publish_one``, the very task this comment was written about, has a
# 150s hard limit, so the one case the window existed to protect was the one it
# was 30s short of.
#
# It is a ceiling, not a cost: a drain with nothing in flight takes about a
# second, so this is only ever spent in exactly the case where spending it is
# the point. ``test_shutdown_is_graceful`` derives the bound from the task
# registry, so a new task with a longer limit fails the suite rather than
# quietly re-opening the gap.
TimeoutStopSec=420

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Herald

StandardOutput=journal
StandardError=journal
SyslogIdentifier=herald-worker

[Install]
WantedBy=multi-user.target
