[Unit]
Description=Herald Celery worker (generation, publishing, metrics)
Documentation=https://github.com/r2st/Herald
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=herald
Group=herald
WorkingDirectory=/opt/Herald/backend
EnvironmentFile=/opt/Herald/.env
# --concurrency=2: the box has 4 GB shared with five other apps, and this
# workload is IO-bound on LLM and platform APIs rather than CPU-bound.
ExecStart=/opt/Herald/.venv/bin/celery -A app.tasks.celery_app:celery_app worker --loglevel=info --concurrency=2
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Herald

StandardOutput=journal
StandardError=journal
SyslogIdentifier=herald-worker

[Install]
WantedBy=multi-user.target
