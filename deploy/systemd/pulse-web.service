[Unit]
Description=Pulse Web (static SPA server)
Documentation=https://github.com/r2st/DoAide-Pulse
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=pulse
Group=pulse
WorkingDirectory=/opt/Pulse
ExecStart=/usr/bin/node /opt/Pulse/deploy/static-server.mjs --root /opt/Pulse/frontend/dist --host 172.18.0.1 --port 3007
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Pulse

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pulse-web

[Install]
WantedBy=multi-user.target
