# ============================================================================
# Herald environment configuration — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real secrets.
# ============================================================================

# ---- App ----
APP_NAME=Herald
ENVIRONMENT=development           # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins for the frontend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# Encrypts stored platform API tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank is tolerated in development. In production, saving a platform
# credential without this set is refused rather than written in the clear.
# Changing it invalidates every stored token — platforms must be reconnected.
TOKEN_ENCRYPTION_KEY=

# ---- Database ----
# Docker compose sets this automatically; override for local runs.
DATABASE_URL=postgresql+psycopg://herald:herald@localhost:5432/herald

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set false to run generation and publishing inline in the request instead of
# on a worker (single-process deployments and tests). Production runs workers:
# leave true.
CELERY_ENABLED=true

# ---- AI (OpenRouter — use FREE models, not Anthropic directly) ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The workhorse, used for short pieces.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Used for tutorials, comparisons and how-tos, where the extra headroom shows.
OPENROUTER_LONG_FORM_MODEL=openai/gpt-oss-120b:free
# Optional attribution headers OpenRouter recommends
OPENROUTER_APP_URL=https://herald.local
OPENROUTER_APP_TITLE=Herald

# ---- AI fallback chain ----
# Tried in order after OpenRouter: Gemini -> Groq -> Cerebras -> static template.
# All speak the OpenAI chat-completions dialect; a provider with a blank key is
# skipped, so configure as few or as many as you like. Every one of these has a
# usable free tier. More configured = fewer template fallbacks on a bad day.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Circuit breaker: skip a provider for this long after this many consecutive
# failures, so one dead upstream costs a timeout once rather than every call.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=300

# ---- GitHub (project change monitoring) ----
# A PAT with read access to the repos you register. Optional: without it the
# monitor still reads public repos at the anonymous 60 req/hour limit.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15

# ---- Autopilot ----
AUTOPILOT_SCAN_INTERVAL_SECONDS=3600      # how often repos are swept
PUBLISH_SCAN_INTERVAL_SECONDS=300         # how often due content is published
METRICS_SCAN_INTERVAL_SECONDS=21600       # how often view counts are polled
# A release always warrants a post; loose commits need this many to qualify.
AUTOPILOT_COMMIT_THRESHOLD=10
# Generated content at or above this confidence may auto-publish (projects set
# to "auto" only). Below it, everything queues for review.
AUTOPILOT_AUTO_PUBLISH_CONFIDENCE=0.8
# Ceiling on autopilot drafts per project per day.
AUTOPILOT_DAILY_CONTENT_LIMIT=2

# ---- Publishing ----
PUBLISH_TIMEOUT_SECONDS=30
# Retries before a publication is parked as `failed` for a human.
PUBLISH_MAX_RETRIES=3

# ---- Seed (optional) ----
# Used by `python -m app.seed`. Without SEED_PASSWORD a random one is generated
# and printed once.
# Must be a routable domain — `EmailStr` rejects special-use TLDs (.local,
# .test, .invalid), so a seeded `dev@herald.local` 500s on /api/v1/auth/me.
SEED_EMAIL=dev@herald.example.com
SEED_PASSWORD=
