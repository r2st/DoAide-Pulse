# ============================================================================
# Pulse environment configuration — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real secrets.
# ============================================================================

# ---- App ----
APP_NAME=Pulse
ENVIRONMENT=development           # development | production
# Leave this false. It buys nothing in development — /docs is already served
# whenever ENVIRONMENT is not production — and this file is what a production
# .env gets copied from. DEBUG=true on a live box reopens /docs *and* hands
# Starlette's traceback page to whoever triggered the error, source lines and
# frame locals included (see app.main.traceback_responses_enabled). Turn it on
# deliberately and briefly when production is what needs poking at.
DEBUG=false
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins for the frontend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# Encrypts stored platform API tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank is tolerated in development. In production, saving a platform
# credential without this set is refused rather than written in the clear.
#
# Accepts a comma-separated list, NEWEST FIRST — the head key encrypts, all of
# them decrypt. To rotate without downtime: prepend the new key, restart, run
# the rewrap sweep (app.tasks.maintenance_tasks.rewrap_credentials), then drop
# the old key. Replacing the value outright makes every stored token, webhook
# secret and trigger secret unreadable. See deploy/DEPLOYMENT.md.
TOKEN_ENCRYPTION_KEY=

# ---- Registration ----
# Pulse is single-user: the account is created once with `python -m app.seed`.
# Leaving this false makes POST /auth/register answer 403 to everyone, which is
# what you want on a public box — an open signup endpoint lets strangers spend
# the shared free-tier LLM quota.
REGISTRATION_ENABLED=false
# If you do open it, you can optionally set an invite token — anyone registering
# must then include it. Left blank, registration is open to anyone.
REGISTRATION_INVITE_TOKEN=

# ---- Password reset ----
# How long a reset link stays valid. It is single-use either way, and requesting
# a new one invalidates any link already outstanding.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---- Draft preview links ----
# A shareable, unauthenticated, read-only link to one draft. The default is what
# a link gets when the author does not ask for a TTL; the max is the ceiling on
# what they may ask for, not a second default.
PREVIEW_LINK_DEFAULT_TTL_HOURS=168   # 7 days
PREVIEW_LINK_MAX_TTL_HOURS=720       # 30 days
# How long a dead link — revoked, or lapsed — is kept before the nightly
# maintenance sweep prunes it. This is not a second expiry: a link stops opening
# at its own expires_at regardless. It is how long the *row* survives, and it
# matters because GET /content/{id}/preview-links returns every link ever issued
# for a draft, so without a sweep that read grows for the life of the account.
# Keep it comfortably past PREVIEW_LINK_MAX_TTL_HOURS (720h = 30 days) so a link
# can never be pruned while it could still open.
PREVIEW_LINK_RETENTION_DAYS=90

# ---- SMTP (the reset email is the only mail Pulse sends) ----
# Leave SMTP_HOST blank and the reset link is written to the log at WARNING
# instead of emailed — a deliberate fallback for a self-hosted single-user
# install, so `journalctl -u pulse-api` can be used to collect your own link.
# The tradeoff is that the link then exists in the logs.
# For Gmail, SMTP_PASSWORD must be an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to pulse@$SMTP_HOST. A From: the relay doesn't own gets you filtered.
SMTP_FROM=
# STARTTLS on 587 (the usual), or implicit TLS on 465. Not both.
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# ---- Rate limiting (all /auth/* endpoints) ----
RATE_LIMIT_ENABLED=true
# Blank = in-process counters, which means *per uvicorn worker* (production runs
# 2, so budgets are effectively doubled). Point this at Redis to share one
# counter across workers: redis://localhost:6379/3
RATE_LIMIT_STORAGE_URI=
# Pulse sits behind Caddy, so request.client.host is always the proxy and every
# caller would land in one bucket. With this on, the rightmost X-Forwarded-For
# entry — the one Caddy appended, which a client cannot forge — is used instead.
# Turn it off only if the app is ever exposed without a trusted proxy in front.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# Any format the `limits` library parses; ";" separates several windows.
RATE_LIMIT_LOGIN=10/minute;100/hour
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_PASSWORD_RESET=5/hour
RATE_LIMIT_AUTH_READ=60/minute

# ---- Database ----
# Docker compose sets this automatically; override for local runs.
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set false to run generation and publishing inline in the request instead of
# on a worker (single-process deployments and tests). Production runs workers:
# leave true.
CELERY_ENABLED=true
# Per-dependency budget for the /api/v1/health probes. Caddy polls that endpoint
# every 30s, so a probe that hangs is itself an outage.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# ---- AI (OpenRouter — use FREE models, not Anthropic directly) ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The workhorse, used for short pieces.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Used for tutorials, comparisons and how-tos, where the extra headroom shows.
OPENROUTER_LONG_FORM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional attribution headers OpenRouter recommends
OPENROUTER_APP_URL=https://pulse.local
OPENROUTER_APP_TITLE=Pulse

# ---- AI fallback chain ----
# Tried in order after OpenRouter: Gemini -> Groq -> Cerebras -> static template.
# All speak the OpenAI chat-completions dialect; a provider with a blank key is
# skipped, so configure as few or as many as you like. Every one of these has a
# usable free tier. More configured = fewer template fallbacks on a bad day.
#
# Configure at least one. OpenRouter's free tier is 50 requests per DAY and the
# quota belongs to the key, not the app — so a key shared with another project
# can be exhausted before Pulse asks for anything. With no fallback configured,
# that turns every generated post into the static template until midnight UTC.
# `GET /api/v1/health` lists the providers that are actually configured.
#
#   Gemini: https://aistudio.google.com/apikey   (generous free tier)
#   Groq:   https://console.groq.com/keys        (cheap; Llama models moved to
#           enterprise-only in 2026, gpt-oss-20b is $0.075/M input)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# A rolling alias. Pinned names get retired — gemini-2.0-flash, which this used
# to be, now answers "is no longer available" on every request.
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Cerebras: https://cloud.cerebras.ai/  (last in the chain)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Extra models to try on the *same* key before moving to the next provider,
# comma-separated. Worth setting on the free tiers, where the quota is metered
# per model: a second model on a key whose first one is spent is a request that
# succeeds, and changing provider is not. An empty value means "no sibling".
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
GEMINI_FALLBACK_MODELS=
GROQ_FALLBACK_MODELS=
CEREBRAS_FALLBACK_MODELS=

# Circuit breaker: skip a provider for this long after this many consecutive
# failures, so one dead upstream costs a timeout once rather than every call.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=300
# A provider that answers 429 with a Retry-After gets that as its cool-down
# instead, capped here. The free tiers hand out day-long windows once a daily
# quota is spent, and the default 300s above would mean paying one refused
# request every five minutes until midnight.
LLM_BREAKER_MAX_COOLDOWN_SECONDS=3600

# Rate limits. When — and only when — a whole pass over the provider chain
# fails on rate limits and nothing else, Pulse waits and sweeps again, up to
# LLM_MAX_ATTEMPTS passes. Nothing is waited on until every provider has been
# asked, so a working provider is never delayed by a rate-limited one ahead of
# it. LLM_RETRY_MAX_BACKOFF_SECONDS caps a single wait, and is also the line
# between "wait for it" (a per-minute limit) and "stand this provider down"
# (a spent daily quota).
LLM_MAX_ATTEMPTS=3
LLM_RETRY_MAX_BACKOFF_SECONDS=30

# How long the per-completion accounting rows behind /api/v1/metrics are kept.
# A daily maintenance sweep drops anything older. This is the widest window the
# metrics endpoint can report on — asking it for more hours than are retained
# reports the rows that survive, not the ones that were written.
LLM_USAGE_RETENTION_DAYS=30

# ---- GitHub (project change monitoring) ----
# A PAT with read access to the repos you register. Optional: without it the
# monitor still reads public repos at the anonymous 60 req/hour limit.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15

# ---- Autopilot ----
AUTOPILOT_SCAN_INTERVAL_SECONDS=3600      # how often repos are swept
PUBLISH_SCAN_INTERVAL_SECONDS=300         # how often due content is published
METRICS_SCAN_INTERVAL_SECONDS=21600       # how often view counts are polled
# A release always warrants a post; loose commits need this many to qualify.
AUTOPILOT_COMMIT_THRESHOLD=10
# Generated content at or above this confidence may auto-publish (projects set
# to "auto" only). Below it, everything queues for review.
AUTOPILOT_AUTO_PUBLISH_CONFIDENCE=0.8
# Ceiling on autopilot drafts per project per day.
AUTOPILOT_DAILY_CONTENT_LIMIT=2

# ---- Publishing ----
PUBLISH_TIMEOUT_SECONDS=30
# Retries before a publication is parked as `failed` for a human.
PUBLISH_MAX_RETRIES=3
# Fast in-process retries inside a single adapter call, for blips that clear in
# seconds. Only replays requests that cannot double-post — a POST is retried on
# 429/503 or a connect error, never on an ambiguous 500 or a read timeout.
PUBLISH_REQUEST_RETRIES=2
PUBLISH_RETRY_BACKOFF_SECONDS=1.0
PUBLISH_RETRY_MAX_BACKOFF_SECONDS=30.0
# Backoff *between* the PUBLISH_MAX_RETRIES attempts above — the outer layer,
# in minutes rather than seconds. A failed publication is parked for this long
# (doubling each attempt, capped) instead of being due again on the next sweep,
# so the retry budget covers a platform outage rather than being spent inside
# the first ten minutes of one. 0 restores the old retry-on-next-sweep.
PUBLISH_RETRY_DEFER_SECONDS=300
PUBLISH_RETRY_MAX_DEFER_SECONDS=3600
# Ceiling on how long a `Retry-After` may park a rate-limited publication.
PUBLISH_RATE_LIMIT_MAX_DEFER_SECONDS=3600

# ---- Weekly digest ----
# The window each Monday email reports on; the comparison is the window before.
DIGEST_WINDOW_DAYS=7
# When the sweep runs, UTC. 0 = Monday. A summary that lands before the week's
# work starts is one that gets acted on.
DIGEST_SEND_WEEKDAY=0
DIGEST_SEND_HOUR=8

# ---- Headline testing ----
# Evidence a headline's window needs before it is ranked at all.
HEADLINE_MIN_SNAPSHOTS=2
HEADLINE_MIN_WINDOW_HOURS=24
# How far ahead a challenger must be before the lead is called rather than
# attributed to noise. Also what stops headlines flapping week to week.
HEADLINE_WINNER_MARGIN=0.25
# How often the sweep re-judges headlines for projects that opted in.
HEADLINE_AUTO_SELECT_INTERVAL_SECONDS=86400

# ---- Velocity and performance alerts ----
# The two early windows every published post is measured over, in hours since it
# went live. Both must comfortably exceed METRICS_SCAN_INTERVAL_SECONDS, or no
# poll lands inside them and every post reports an unknown first day.
VELOCITY_EARLY_WINDOW_HOURS=24
VELOCITY_BENCHMARK_WINDOW_HOURS=48
# Posts on a platform before its median is used to judge an individual one.
VELOCITY_MIN_SAMPLE=3
# Below this fraction of the platform median, a post is flagged. Deliberately
# far out: an alert that fires on a normal week trains you to ignore the panel.
UNDERPERFORMANCE_THRESHOLD=0.5
# A post whose trailing-window views fall to this fraction of its own best
# equivalent window has stopped growing.
VELOCITY_STALL_WINDOW_HOURS=168
VELOCITY_STALL_RATIO=0.1

# ---- Learned posting times ----
# Derive best hour and weekdays per platform from your own first-day views,
# falling back to the built-in table until there is enough evidence. False uses
# the table everywhere.
LEARNED_CADENCE_ENABLED=true
# Posts on a platform before any timing is learned, and posts sharing an hour
# before that hour can win. Both bars must clear.
LEARNED_CADENCE_MIN_SAMPLES=5
LEARNED_CADENCE_MIN_BUCKET=2

# ---- Scheduling ----
# How far into the past a requested publish time may fall before it is refused,
# so a client clock a minute behind the server is not an error.
SCHEDULE_PAST_GRACE_SECONDS=120
# Ceiling on how far ahead something may be scheduled — catches a mistyped year
# that would otherwise park a post in silence.
SCHEDULE_MAX_HORIZON_DAYS=365

# ---- Seed (optional) ----
# Used by `python -m app.seed`. Without SEED_PASSWORD a random one is generated
# and printed once.
# Must be a routable domain — `EmailStr` rejects special-use TLDs (.local,
# .test, .invalid), so a seeded `dev@pulse.local` 500s on /api/v1/auth/me.
SEED_EMAIL=dev@pulse.example.com
SEED_PASSWORD=
